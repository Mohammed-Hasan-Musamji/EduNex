# Copy this file to .env and fill in real values. Never commit the real .env file.

# --- Application ---
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Database ---
# Postgres with the pgvector extension enabled. See README.md for setup.
DATABASE_URL=postgresql+psycopg://edunex:edunex@localhost:5432/edunex
# Supabase (session pooler, IPv4-friendly) -- see docs/SUPABASE_VECTOR_SETUP.md:
# DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<url-encoded-password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# Never put Supabase service-role or anon keys in this file or in the frontend; the backend only needs the database URL.

# --- CORS ---
# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:3000

# --- Authentication ---
# Signing secret for session JWTs. Generate a real one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Never reuse this placeholder and never commit the real value.
SECRET_KEY=change-me-generate-a-real-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=10080
SESSION_COOKIE_NAME=edunex_session
# Set to true only when serving the frontend over HTTPS.
SESSION_COOKIE_SECURE=false

# --- Google Gemini ---
# Never expose this key to the browser. Leave blank to run without AI generation
# (lesson-generation endpoints will return 503 Service Unavailable).
GEMINI_API_KEY=
# Verify any model name with `python -m scripts.diagnose_gemini` before relying on it.
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=768
GEMINI_TIMEOUT_SECONDS=30

# --- RAG ---
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
RAG_TOP_K=4
RAG_MIN_SIMILARITY=0.55

# --- Learning activity ---
# IANA timezone whose calendar days count as "learning days" for streaks.
ACTIVITY_TIMEZONE=UTC
